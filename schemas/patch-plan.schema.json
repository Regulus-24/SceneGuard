{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneguard.local/schemas/patch-plan.schema.json",
  "title": "SceneGuard Patch Plan 0.1",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "asset_sha256",
    "profile",
    "state",
    "steps",
    "risk_level",
    "approval_required",
    "reason",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "plan_id": {"type": "string", "pattern": "^plan-[a-f0-9]{12}$"},
    "asset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profile": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "state": {"enum": ["NO_ACTION", "READY", "MANUAL_ONLY"]},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "risk_level": {"enum": ["L0", "L1", "L2", "L3"]},
    "approval_required": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "step": {
      "type": "object",
      "required": [
        "step_id",
        "finding_ids",
        "skill",
        "operation",
        "parameters",
        "expected_changes",
        "verify_rules",
        "risk_level",
        "rollback_on"
      ],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "finding_ids": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "skill": {"type": "string", "minLength": 1},
        "operation": {"enum": ["remove_degenerate_triangles", "resize_embedded_textures"]},
        "parameters": {"type": "object"},
        "expected_changes": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "verify_rules": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "risk_level": {"enum": ["L0", "L1", "L2", "L3"]},
        "rollback_on": {"$ref": "#/$defs/nonEmptyUniqueStrings"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
