{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneguard.local/schemas/audit-report.schema.json",
  "title": "SceneGuard Audit Report 0.1",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "asset",
    "profile",
    "measurements",
    "findings",
    "checks_completed",
    "checks_incomplete",
    "summary",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "job_id": {"type": "string", "minLength": 1},
    "asset": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "measurements": {"type": "object"},
    "findings": {"type": "array", "items": {"$ref": "finding.schema.json"}},
    "checks_completed": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "checks_incomplete": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "summary": {
      "type": "object",
      "required": ["gate_state", "error_count", "warning_count"],
      "properties": {
        "gate_state": {"enum": ["PASS", "REJECTED"]},
        "error_count": {"type": "integer", "minimum": 0},
        "warning_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
