{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneguard.local/schemas/goal-contract.schema.json",
  "title": "SceneGuard Goal Contract / Quality Profile 0.1",
  "type": "object",
  "required": ["profile_id", "version", "description", "rules", "repair_policy"],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "rules": {
      "type": "object",
      "required": [
        "max_file_bytes",
        "max_triangles",
        "max_texture_dimension",
        "allow_external_uris",
        "require_embedded_buffers"
      ],
      "properties": {
        "max_file_bytes": {"type": "integer", "minimum": 1},
        "max_triangles": {"type": "integer", "minimum": 1},
        "max_texture_dimension": {"type": "integer", "minimum": 1},
        "allow_external_uris": {"type": "boolean"},
        "require_embedded_buffers": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "repair_policy": {
      "type": "object",
      "required": ["allowed_operations"],
      "properties": {
        "allowed_operations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "operation_risk_levels": {
          "type": "object",
          "additionalProperties": {"enum": ["L0", "L1", "L2", "L3"]}
        },
        "auto_execute_risk_levels": {"$ref": "#/$defs/riskLevels"},
        "approval_required_risk_levels": {"$ref": "#/$defs/riskLevels"},
        "denied_risk_levels": {"$ref": "#/$defs/riskLevels"},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "riskLevels": {
      "type": "array",
      "items": {"enum": ["L0", "L1", "L2", "L3"]},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
